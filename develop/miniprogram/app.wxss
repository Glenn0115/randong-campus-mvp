page {
  min-height: 100%;
  background: #f5f7f6;
  color: #10201d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
button,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dbe4e2;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.title {
  color: #10201d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #e7f5f2;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 44rpx;
}

.primary-button {
  height: 88rpx;
  border-radius: 10rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.secondary-button {
  height: 80rpx;
  border: 1rpx solid #0f766e;
  border-radius: 10rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 28rpx;
  line-height: 80rpx;
}

.ghost-button {
  height: 72rpx;
  border: 1rpx solid #dbe4e2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #334155;
  font-size: 26rpx;
  line-height: 72rpx;
}

.danger-button {
  height: 72rpx;
  border-radius: 10rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 72rpx;
}

.input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe4e2;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx;
  border: 1rpx solid #dbe4e2;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option {
  width: calc((100% - 16rpx) / 2);
  min-height: 76rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #dbe4e2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #334155;
  font-size: 26rpx;
}

.option.active {
  border-color: #0f766e;
  background: #e7f5f2;
  color: #0f766e;
  font-weight: 600;
}

.progress {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #0f766e;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
