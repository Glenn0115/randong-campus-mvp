.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-value {
  display: flex;
  align-items: center;
  color: #334155;
}

.proof-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.proof-row:last-child {
  border-bottom: 0;
}
