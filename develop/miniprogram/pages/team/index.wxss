.no-team {
  margin-top: 8rpx;
}

.field {
  margin-top: 18rpx;
}

.sample-code {
  margin: 12rpx 0;
}

.team-code {
  display: inline-flex;
  margin: 20rpx 0 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #edf7ee;
  color: #166534;
  font-size: 24rpx;
}

.progress-text {
  margin-top: 12rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}

.member {
  display: flex;
  width: calc((100% - 18rpx) / 2);
  align-items: center;
  gap: 12rpx;
}

.avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e7f5f2;
  color: #0f766e;
  font-weight: 700;
}

.member-name {
  font-size: 26rpx;
  font-weight: 700;
}

.invite-button {
  width: 128rpx;
  flex-shrink: 0;
}

.invite-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.invite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.empty-line {
  margin-top: 18rpx;
}
