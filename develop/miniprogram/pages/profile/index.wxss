.setting-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.report-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.empty-line {
  margin-top: 16rpx;
}
