.tab-row {
  display: flex;
  gap: 12rpx;
}

.tab {
  flex: 1;
  min-height: 68rpx;
  border: 1rpx solid #dbe4e2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #475569;
  font-size: 24rpx;
  line-height: 68rpx;
  text-align: center;
}

.tab.active {
  border-color: #0f766e;
  background: #e7f5f2;
  color: #0f766e;
  font-weight: 700;
}

.rank-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.rank-index {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #0f766e;
  color: #ffffff;
  font-weight: 700;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name {
  margin-bottom: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.rank-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.metric {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
}

.report-button {
  width: 108rpx;
  height: 56rpx;
  font-size: 22rpx;
  line-height: 56rpx;
}
