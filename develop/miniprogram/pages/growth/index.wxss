.level-line {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin: 20rpx 0 16rpx;
}

.group-title {
  margin: 8rpx 0 16rpx;
}

.title-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.title-name {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.set-button {
  width: 140rpx;
  flex-shrink: 0;
}

.locked-card {
  opacity: 0.78;
}
